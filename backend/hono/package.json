{
	"name": "hono",
	"scripts": {
		"dev": "bun run --hot server.ts",
		"format": "biome format --write",
		"lint": "biome check --fix",
		"migrate": "bunx --bun knex migrate:latest",
		"migrate:rollback": "bunx --bun knex migrate:rollback",
		"migrate:make": "bunx --bun knex migrate:make -x ts",
		"build:prod": "bun build ./server.ts --outfile=server --compile --minify -e oracledb -e pg -e sqlite3 -e mysql -e pg-query-stream -e better-sqlite3 -e tedious"
	},
	"dependencies": {
		"@sentry/bun": "^10.32.1",
		"@vinejs/vine": "^4.2.0",
		"hono": "^4.11.1",
		"knex": "^2.5.1",
		"mysql2": "^3.3.1",
		"objection": "^3.1.5",
		"reflect-metadata": "^0.2.2",
		"typedi": "^0.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "latest"
	}
}
