{
	"name": "hono",
	"scripts": {
		"dev": "bun run --hot index.ts",
		"format": "biome format --write",
		"migrate": "bunx --bun knex migrate:latest",
		"migrate:rollback": "bunx --bun knex migrate:rollback",
		"migrate:make": "bunx --bun knex migrate:make",
		"build:prod": "bun build ./index.ts --outfile=server --compile --minify"
	},
	"dependencies": {
		"hono": "^4.11.1",
		"knex": "^2.5.1",
		"mysql2": "^3.3.1",
		"reflect-metadata": "^0.2.2",
		"typedi": "^0.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "latest"
	}
}
